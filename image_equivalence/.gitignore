# Only *_baseline reference sets are committed. Per-run outputs are transient:
rlvk/
rlgl/
rlsw_candidate/
diffs_rlvk/
diffs_rlsw/
report_rlvk.html
report_rlsw.html

# Regression-subset run outputs (see run_regression_rlvk.sh)
rlvk_regression/
diffs_rlvk_regression/
report_rlvk_regression.html

# Ad-hoc analysis outputs (alternate candidate sets and their reports/diffs). The committed
# artifacts stay: *_baseline reference sets only.
rlvk_optoff/
diffs_*/
report_rlvk_optoff*.html
report_rlvk_vs_*.html
report_spirvopt_ab.html
report_ctl_*.html
report_measure.html
report_lavapipe.html
report_llvmpipe.html
report_software_stack.html
report_rlvk_linux_amd.html
rlvk_lavapipe/
rlgl_llvmpipe/

# macOS per-machine artifacts: baselines and candidates are machine-local (cross-driver
# variance exceeds cross-backend variance, so they are never meaningful off-machine).
# Only the .ini configs (thresholds/allowances) are committed.
rlgl_baseline_macos/
rlgl_macos_check/
rlmtl_macos/
rlvk_macos_*/
report_rlmtl*.html
report_rlvk_macos*.html
report_glglcheck.html
report_rlvk_selfcheck.html
tmp_*.ini

# rldx12 (Direct3D 12 backend) run outputs
rldx12/
rldx12_regression/
rldx12_probe/
rldx12_compute_probe/
report_rldx12_probe.html
