raylib_version                         "6.1-dev"                        # raylib version used to render
machine                                "mac"                            # host machine name
os                                     "macOS"                          # operating system
gpu                                    "Apple M5"                       # graphics card (GL_RENDERER)
gpu_vendor                             "Apple"                          # graphics vendor (GL_VENDOR)
graphics_driver                        "4.1 Metal - 90.5"               # GL_VERSION string (includes driver)
